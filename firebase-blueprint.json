{
  "entities": {
    "User": {
      "title": "User",
      "description": "App user with roles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "username": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["Admin", "Sales User"] },
        "name": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "UserIndex": {
      "title": "User Index",
      "description": "Lookup mapping for identifiers to emails",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "type": { "type": "string", "enum": ["username", "phone"] }
      },
      "required": ["email", "type"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Sales lead information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["New", "Contacted", "Qualified", "Lost"] },
        "source": { "type": "string", "enum": ["Website", "Instagram", "Referral"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["name", "email", "status", "source", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and roles"
    },
    "/user_indices/{indexId}": {
      "schema": "UserIndex",
      "description": "Identifier to email mappings"
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Sales leads"
    }
  }
}
